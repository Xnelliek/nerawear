# --- Core ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
ALLOWED_HOSTS=api.nerawear.com,localhost,127.0.0.1

# --- PostgreSQL ------------------------------------------------------------
DATABASE_URL=postgres://nera:password@localhost:5432/nerawear

# --- Frontend origins allowed to call the API ------------------------------
CORS_ALLOWED_ORIGINS=https://nerawear.com,https://www.nerawear.com,http://localhost:8080
CSRF_TRUSTED_ORIGINS=https://nerawear.com,https://www.nerawear.com

# --- Media: local | cloudinary | s3 ---------------------------------------
MEDIA_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# When MEDIA_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1

# --- Store / M-Pesa (manual Pochi la Biashara flow) ------------------------
MPESA_PAYBILL_NAME=Pochi la Biashara
MPESA_PHONE=0748609410
DELIVERY_FEE_NAIROBI_KES=300
DELIVERY_FEE_UPCOUNTRY_KES=450
FREE_DELIVERY_THRESHOLD_KES=10000

# --- Email -----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=orders@nerawear.com
ADMIN_NOTIFY_EMAIL=orders@nerawear.com

# --- SMS (Africa's Talking) ------------------------------------------------
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=NERAWEAR
